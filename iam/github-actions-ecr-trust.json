        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
          "token.actions.githubusercontent.com:sub": "repo:AhmedMHCodeLab@145441921/accounts-api-devsecops@1360765416:ref:refs/heads/main",
          "token.actions.githubusercontent.com:repository_owner_id": "145441921",
          "token.actions.githubusercontent.com:repository_id": "1360765416",
          "token.actions.githubusercontent.com:workflow": "Build and Sign",
          "token.actions.githubusercontent.com:ref": "refs/heads/main"
        }
      }
    }
  ]
}